# Copy to .env.local (untracked) and adjust. Read by the root `pnpm dev` script
# and, for OSP_FOREIGN_DATABASES only, by the test isolation guardrail.

# Your personal planning database. There is deliberately NO default anywhere
# (see CLAUDE.md, "HARD GUARDRAIL"): every boot must name its database.
DATABASE_URL=postgres://localhost:5432/osp

# API port for your own dev session (the web dev server proxies /api to 3001).
PORT=3001

# Databases of OTHER projects on the same Postgres server, comma-separated.
# Tests, e2e and restore/migration scripts refuse to touch them.
OSP_FOREIGN_DATABASES=

# ── Sign-in (Increment 39) ─────────────────────────────────────────────────
# REQUIRED, no default: "entra" (Microsoft Entra ID sign-in, Planner/Viewer
# roles) or "none" (no sign-in — everyone is a Planner; local single-user use).
OSP_AUTH=none

# The rest is required only with OSP_AUTH=entra (startup lists what's missing).
# Browser-facing origin; the Entra redirect URI is ${OSP_PUBLIC_URL}/api/auth/callback.
#OSP_PUBLIC_URL=http://localhost:5173
# base64 of >= 32 random bytes, e.g. `openssl rand -base64 48`. Encrypts the
# session cookie — changing it signs everyone out.
#OSP_SESSION_SECRET=<base64-random-bytes>
# Entra app registration (Directory/tenant ID, Application/client ID, secret).
#OSP_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
#OSP_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
#OSP_ENTRA_CLIENT_SECRET=<client-secret>
