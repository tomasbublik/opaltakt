{
  "name": "@osp/fixtures",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./mock-op-server.ts",
    "./data/*": "./data/*",
    "./scenario-types": "./scenario-types.ts",
    "./scenarios": "./scenarios/index.ts"
  },
  "scripts": {
    "dev": "tsx mock-op-server.ts",
    "start": "tsx mock-op-server.ts",
    "start:second": "MOCK_OP_PORT=8098 tsx mock-op-server.ts",
    "sim": "tsx sim.ts",
    "sim:log-time": "tsx sim.ts log-time",
    "sim:set-status": "tsx sim.ts set-status",
    "scenario": "tsx scenario.ts",
    "scenario:day": "tsx scenario.ts day",
    "scenario:urgent": "tsx scenario.ts urgent",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@osp/op-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
